# Copy to config/.env and fill in. config/.env is git-ignored. Never commit keys.
# Every value below is optional unless marked REQUIRED.

# ---------------------------------------------------------------- LLM
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=            # REQUIRED for conversation
OPENROUTER_MODEL=openai/gpt-4.1-mini
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.8
LLM_JSON_MODE=true
HISTORY_TOKEN_BUDGET=1500
HISTORY_MAX_MESSAGES=24

# ---------------------------------------------------------------- Svara TTS
# Svara's documented server is OpenAI-compatible: POST {SVARA_BASE_URL}/audio/speech
# SVARA_BASE_URL must therefore include the /v1 suffix, e.g. https://host/v1
SVARA_API_KEY=
SVARA_BASE_URL=
SVARA_VOICE=en_female          # voice ids look like en_female, en_male, hi_female ...
SVARA_TIMEOUT_S=30
SVARA_EMOTION_TAGS=false       # append <happy>/<sad> style tags (model-card feature)
# auto = svara when key+url are set, otherwise mock
TTS_PROVIDER=auto

# ---------------------------------------------------------------- Input
INPUT_MODE=text                # text | voice
LISTEN_TIMEOUT_S=20
BARGE_IN=false                 # interrupt speech when you talk (needs tuning)

# Speech-to-text: any OpenAI-compatible /audio/transcriptions endpoint (Groq by default)
STT_PROVIDER=auto              # auto | openai_compatible | mock
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
STT_TIMEOUT_S=20

# ---------------------------------------------------------------- Audio devices
AUDIO_IN=auto                  # auto | real | mock
AUDIO_OUT=auto                 # auto | real | mock
AUDIO_IN_DEVICE=default        # run `arecord -l`, e.g. plughw:1,0
AUDIO_OUT_DEVICE=default       # run `aplay -l`, e.g. plughw:1,0
MIC_GAIN=1.0                   # software gain; INMP441 is quiet, try 4.0-8.0
VAD_MIN_RMS=300
VAD_THRESHOLD_FACTOR=3.0
VAD_SILENCE_MS=800
VAD_MAX_UTTERANCE_S=15

# ---------------------------------------------------------------- Display (ST7789, SPI0)
DISPLAY=auto                   # auto | real | mock
DISPLAY_FPS=12
DISPLAY_ROTATION=0             # 0 | 90 | 180 | 270
DISPLAY_SPI_HZ=32000000
DISPLAY_SPI_MODE=3             # 3 works for modules with and without a CS pin; try 0 if garbled
DISPLAY_DC_PIN=25
DISPLAY_RST_PIN=27
DISPLAY_BL_PIN=24
DISPLAY_X_OFFSET=              # leave empty for automatic
DISPLAY_Y_OFFSET=
DISPLAY_PREVIEW_PATH=          # mock display: write a PNG preview here, e.g. logs/eyes.png
EYE_COLOR=#35d0ff
IDLE_SLEEP_S=180

# ---------------------------------------------------------------- Memory
MEMORY_DB_PATH=data/meow.db
MEMORY_PERSIST_HISTORY=true
MEMORY_MAX_TURNS=40
MEMORY_MAX_FACTS=200

# ---------------------------------------------------------------- Movement (TB6612FNG)
# Motors never move unless MOVEMENT_ENABLED=true AND the user explicitly arms
# movement at runtime. Real motor output also requires MOTORS=real (auto only
# uses real motors when MOVEMENT_ENABLED=true).
MOVEMENT_ENABLED=false
MOTORS=auto                    # auto | real | mock
MOTOR_AIN1_PIN=5
MOTOR_AIN2_PIN=6
MOTOR_PWMA_PIN=12
MOTOR_BIN1_PIN=16
MOTOR_BIN2_PIN=26
MOTOR_PWMB_PIN=13
MOTOR_STBY_PIN=23
MOTOR_MAX_SPEED=0.6            # 0-1 hard cap
MOTOR_DEFAULT_SPEED=0.5
MOTOR_MAX_RUN_S=2.0            # hard cap per command
MOTOR_DEFAULT_RUN_S=1.0

# ---------------------------------------------------------------- Logging
LOG_LEVEL=INFO
LOG_FILE=logs/meow.log
